{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_MCP_PAT}"
        },
        "timeout": {
          "startup": 60000,
          "catalog": 60000
        }
      },
      "dbhub": {
        "type": "local",
        "cwd": ".",
        "command": [
          "bash",
          "-c",
          "set -a; . ./.env; set +a; exec /home/brian/.local/bin/npx -y @bytebase/dbhub@latest --transport stdio --config ./dbhub.toml"
        ],
        "environment": {
          "PATH": "/home/brian/.local/bin:/usr/local/bin:/usr/bin:/bin"
        }
      },
      "markitdown": {
        "type": "local",
        "cwd": ".",
        "command": [
          "/home/brian/.local/bin/uvx",
          "--python",
          "3.12",
          "markitdown-mcp"
        ],
        "environment": {
          "PATH": "/home/brian/.local/bin:/usr/local/bin:/usr/bin:/bin"
        }
      }
    }
  }
}
