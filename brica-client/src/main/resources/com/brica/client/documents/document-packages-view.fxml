<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.brica.client.documents.presentation.DocumentPackagesController" fx:id="pane" spacing="9" styleClass="content-card">
    <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
    <Label text="Paquetes documentales" styleClass="content-title"/>
    <Label text="Selecciona el contexto y organiza las plantillas del paquete."
           wrapText="true" styleClass="content-description"/>
    <VBox spacing="8" styleClass="package-list-section">
        <Label text="Paquetes guardados" styleClass="package-section-title"/>
        <ListView fx:id="packages" minHeight="65" prefHeight="95"/>
        <HBox spacing="8" styleClass="document-actions"><Button text="Anterior" onAction="#previous"/><Button text="Siguiente" onAction="#next"/><Button text="Actualizar lista" onAction="#refresh"/>
            <Button text="Editar seleccionado" onAction="#open"/><Button text="Nuevo paquete" onAction="#newPackage" styleClass="primary-button"/>
            <Button text="Continuar captura" onAction="#resume"/></HBox>
    </VBox>
    <Label fx:id="message" wrapText="true" styleClass="package-feedback"/>
    <VBox fx:id="form" spacing="12" prefWidth="720" styleClass="package-form">
     <Label text="Configuración del paquete" styleClass="package-section-title"/>
     <Label text="Nombre técnico del paquete" styleClass="form-label"/><TextField fx:id="name"/>
     <Separator/>
     <Label text="Contexto" styleClass="package-section-title"/>
     <HBox fx:id="clientSelector" spacing="6"><Label text="Cliente" styleClass="form-label"/><ComboBox fx:id="clientChoice" prefWidth="220"/><Button text="Cargar clientes" onAction="#loadClients"/><Button text="Anterior" onAction="#previousClients"/><Button text="Siguiente" onAction="#nextClients"/></HBox>
     <HBox fx:id="workSelector" spacing="6"><Label text="Obra" styleClass="form-label"/><ComboBox fx:id="workChoice" prefWidth="220"/><Button text="Cargar obras" onAction="#loadWorks"/><Button text="Anterior" onAction="#previousWorks"/><Button text="Siguiente" onAction="#nextWorks"/></HBox>
     <Label fx:id="clientContext" text="Selecciona un cliente o una obra." styleClass="package-context"/>
     <Label text="Seleccionar clientes requiere CLIENTS_READ; seleccionar obras requiere WORKS_READ. Los permisos documentales no conceden esos accesos." wrapText="true" styleClass="content-note"/>
     <Label fx:id="state" text="Nuevo paquete" styleClass="package-state"/>
     <Separator/>
     <Label text="Plantillas del paquete" styleClass="package-section-title"/>
     <Label text="Selecciona las plantillas. Solo las vigentes con una versión vigente estarán disponibles para uso." wrapText="true" styleClass="content-description"/>
     <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" minHeight="130"><content><VBox fx:id="templateChoices" spacing="8"/></content></ScrollPane>
     <HBox spacing="8" styleClass="document-actions"><Button text="Cargar más plantillas" onAction="#moreTemplates"/><Button text="Registrar una plantilla" onAction="#registerTemplate" styleClass="primary-button"/>
         <Label text="La captura se conserva. Vuelve con Continuar captura." wrapText="true"/></HBox>
     <HBox spacing="8" styleClass="document-actions"><Button text="Guardar paquete" onAction="#saveDraft" styleClass="primary-button"/>
         <Button text="Confirmar paquete" onAction="#confirm"/>
         <Button text="Eliminar paquete" onAction="#discard" styleClass="danger-button"/></HBox>
     <Label fx:id="dialogMessage" wrapText="true" styleClass="package-feedback"/>
    </VBox>
</VBox>
