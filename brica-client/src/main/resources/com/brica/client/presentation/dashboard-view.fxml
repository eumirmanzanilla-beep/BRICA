<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.brica.client.presentation.DashboardController"
    fitToWidth="true"
    hbarPolicy="NEVER"
    vbarPolicy="AS_NEEDED"
    styleClass="dashboard-scroll">

    <content>
        <VBox
            spacing="20.0"
            fillWidth="true"
            styleClass="dashboard-root">

            <!-- PRESENTACIÓN -->
            <VBox spacing="6.0">

                <Label
                    text="Bienvenido a BRICA"
                    styleClass="content-title"/>

                <Label
                    text="Accede a las principales funciones de gestión administrativa y documental."
                    wrapText="true"
                    styleClass="content-description"/>

            </VBox>

            <!-- ACCESOS A MÓDULOS -->
            <Label
                text="Módulos principales"
                styleClass="dashboard-section-title"/>

            <GridPane hgap="16.0" vgap="16.0">

                <columnConstraints>
                    <ColumnConstraints
                        percentWidth="50.0"
                        hgrow="ALWAYS"/>

                    <ColumnConstraints
                        percentWidth="50.0"
                        hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- CLIENTES -->
                <VBox
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="0"
                    spacing="10.0"
                    maxWidth="Infinity"
                    minHeight="142.0"
                    styleClass="dashboard-card">

                    <Label
                        text="Clientes"
                        styleClass="dashboard-card-title"/>

                    <Label
                        text="Consulta, registra y administra la información de tus clientes."
                        wrapText="true"
                        styleClass="content-description"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Button
                        text="Abrir Clientes"
                        onAction="#onOpenClients"
                        styleClass="dashboard-link-button"/>

                </VBox>

                <!-- OBRAS -->
                <VBox
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="0"
                    spacing="10.0"
                    maxWidth="Infinity"
                    minHeight="142.0"
                    styleClass="dashboard-card">

                    <Label
                        text="Obras"
                        styleClass="dashboard-card-title"/>

                    <Label
                        text="Consulta las obras registradas y administra su información."
                        wrapText="true"
                        styleClass="content-description"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Button
                        text="Abrir Obras"
                        onAction="#onOpenWorks"
                        styleClass="dashboard-link-button"/>

                </VBox>

                <!-- CONTRATOS -->
                <VBox
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="1"
                    spacing="10.0"
                    maxWidth="Infinity"
                    minHeight="142.0"
                    styleClass="dashboard-card">

                    <Label
                        text="Contratos"
                        styleClass="dashboard-card-title"/>

                    <Label
                        text="Registra contratos vinculados a obras existentes."
                        wrapText="true"
                        styleClass="content-description"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Button
                        text="Abrir Contratos"
                        onAction="#onOpenContracts"
                        styleClass="dashboard-link-button"/>

                </VBox>

                <!-- DOCUMENTACIÓN FUTURA -->
                <VBox
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="1"
                    spacing="10.0"
                    maxWidth="Infinity"
                    minHeight="142.0"
                    styleClass="dashboard-card">

                    <Label
                        text="Documentación"
                        styleClass="dashboard-card-title"/>

                    <Label
                        text="Gestión de plantillas y generación documental en próximas etapas."
                        wrapText="true"
                        styleClass="content-description"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Label
                        text="Próximamente"
                        styleClass="dashboard-pending"/>

                </VBox>

            </GridPane>

            <!-- OBRAS REGISTRADAS -->
            <VBox spacing="14.0" styleClass="content-card">

                <HBox alignment="CENTER_LEFT" spacing="12.0">

                    <VBox spacing="5.0">
                        <Label
                            text="Obras registradas"
                            styleClass="dashboard-section-title"/>

                        <Label
                            text="Acceso a la información general de las obras."
                            styleClass="content-description"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button
                        text="Ver obras"
                        onAction="#onOpenWorks"
                        styleClass="secondary-button"/>

                </HBox>

                <TableView
                    fx:id="worksTable"
                    prefHeight="230.0"
                    minHeight="190.0"
                    styleClass="data-table">

                    <columns>
                        <TableColumn
                            text="ID"
                            prefWidth="70.0"/>

                        <TableColumn
                            text="Obra"
                            prefWidth="245.0"/>

                        <TableColumn
                            text="Ubicación"
                            prefWidth="190.0"/>

                        <TableColumn
                            text="Fecha de inicio"
                            prefWidth="145.0"/>
                    </columns>

                    <placeholder>
                        <Label
                            text="El listado se conectará a la API en la etapa de integración."
                            wrapText="true"
                            styleClass="dashboard-table-placeholder"/>
                    </placeholder>

                </TableView>

            </VBox>

            <!-- ESTADO DEL SISTEMA -->
            <HBox
                alignment="CENTER_LEFT"
                spacing="14.0"
                styleClass="dashboard-status-card">

                <VBox spacing="6.0">

                    <Label
                        text="Estado del sistema"
                        styleClass="dashboard-section-title"/>

                    <Label
                        fx:id="dashboardServerStatusLabel"
                        text="Servidor no verificado"
                        wrapText="true"
                        styleClass="server-status"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                    text="Comprobar conexión"
                    onAction="#onCheckServer"
                    styleClass="secondary-button"/>

            </HBox>

        </VBox>
    </content>

</ScrollPane>
