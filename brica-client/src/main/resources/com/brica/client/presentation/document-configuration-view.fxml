<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<TabPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.brica.client.presentation.DocumentConfigurationController" fx:id="tabs" tabClosingPolicy="UNAVAILABLE">
    <tabs>
        <Tab fx:id="fieldsTab" text="Campos"><content><fx:include fx:id="fields" source="reference-fields-view.fxml"/></content></Tab>
        <Tab fx:id="templatesTab" text="Plantillas"><content><fx:include fx:id="templates" source="templates-view.fxml"/></content></Tab>
        <Tab fx:id="packagesTab" text="Paquetes"><content><fx:include fx:id="packages" source="document-packages-view.fxml"/></content></Tab>
        <Tab fx:id="valuesTab" text="Valores por obra"><content><fx:include fx:id="values" source="reference-values-view.fxml"/></content></Tab>
    </tabs>
</TabPane>
