<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.brica.client.presentation.ReferenceFieldsController" fx:id="pane" spacing="10" styleClass="content-card">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Label text="Catálogo de campos" styleClass="content-title"/>
    <Label text="Solo nombres de obra y cliente. La clave y su origen no se modifican al renombrar." wrapText="true"/>
    <ListView fx:id="fields" VBox.vgrow="ALWAYS" minHeight="100"/>
    <HBox spacing="8"><Button text="Anterior" onAction="#previous"/><Label fx:id="pageLabel"/><Button text="Siguiente" onAction="#next"/><Button text="Actualizar" onAction="#refresh"/></HBox>
    <HBox spacing="10"><VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Clave canónica"/><TextField fx:id="key" promptText="NOMBRE_OBRA"/></VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Nombre visible"/><TextField fx:id="visibleName"/></VBox></HBox>
    <Label text="Atributo de origen para un campo nuevo"/><ComboBox fx:id="attribute" maxWidth="Infinity"/>
    <HBox spacing="8"><Button text="Registrar campo nuevo" onAction="#create"/><Button text="Renombrar seleccionado" onAction="#rename"/></HBox>
    <Label fx:id="message" wrapText="true"/>
</VBox>
