<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.brica.client.presentation.MainController"
    stylesheets="@styles/app.css"
    styleClass="app-root"
    prefWidth="1100.0"
    prefHeight="700.0">

    <!-- MENÚ LATERAL -->
    <left>
        <VBox
            prefWidth="210.0"
            minWidth="210.0"
            maxWidth="210.0"
            spacing="12.0"
            styleClass="sidebar">

            <padding>
                <Insets top="20" right="14" bottom="16" left="14"/>
            </padding>

            <!-- IDENTIDAD -->
            <HBox alignment="CENTER_LEFT" spacing="10">

                <Label
                    text="B"
                    styleClass="brand-mark"/>

                <VBox spacing="2">

                    <Label
                        text="BRICA"
                        styleClass="brand-name"/>

                    <Label
                        text="GESTIÓN CONSTRUCTORA"
                        styleClass="brand-description"/>

                </VBox>

            </HBox>

            <Separator/>

            <!-- NAVEGACIÓN -->
            <Label
                text="NAVEGACIÓN"
                styleClass="sidebar-heading"/>

            <Button
                fx:id="homeNavButton"
                text="Inicio"
                onAction="#onNavigateHome"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                styleClass="nav-button"/>

            <Button
                fx:id="clientsNavButton"
                text="Clientes"
                onAction="#onNavigateClients"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                styleClass="nav-button"/>

            <Button
                fx:id="worksNavButton"
                text="Obras"
                onAction="#onNavigateWorks"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                styleClass="nav-button"/>

            <Button
                fx:id="contractsNavButton"
                text="Contratos"
                onAction="#onNavigateContracts"
                maxWidth="Infinity"
                alignment="CENTER_LEFT"
                styleClass="nav-button"/>

            <Button fx:id="documentsNavButton" text="Catálogo de campos" onAction="#onNavigateDocuments"
                    maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="nav-button"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Cerrar sesión" onAction="#onLogout" maxWidth="Infinity" styleClass="nav-button"/>

            <Separator/>

            <!-- ESTADO DEL SISTEMA -->
            <Label
                text="ESTADO DEL SISTEMA"
                styleClass="sidebar-heading"/>

            <Label
                fx:id="serverStatusLabel"
                text="Servidor no verificado"
                wrapText="true"
                maxWidth="Infinity"
                styleClass="server-status"/>

            <Button
                fx:id="checkServerButton"
                text="Comprobar servidor"
                onAction="#onCheckServer"
                maxWidth="Infinity"
                styleClass="server-check-button"/>

        </VBox>
    </left>

    <!-- ZONA PRINCIPAL -->
    <center>
        <BorderPane styleClass="workspace">

            <!-- ENCABEZADO -->
            <top>
                <HBox
                    alignment="CENTER_LEFT"
                    spacing="16.0"
                    prefHeight="86.0"
                    styleClass="workspace-header">

                    <padding>
                        <Insets top="15" right="26" bottom="15" left="26"/>
                    </padding>

                    <VBox spacing="5">

                        <Label
                            fx:id="sectionTitleLabel"
                            text="Panel de inicio"
                            styleClass="header-title"/>

                        <Label
                            fx:id="sectionSubtitleLabel"
                            text="Gestión administrativa y documental"
                            styleClass="header-subtitle"/>

                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label
                        text="BRICA · Bloque 1"
                        styleClass="header-meta"/>

                </HBox>
            </top>

            <!-- CONTENIDO DINÁMICO -->
            <center>
                <StackPane
                    fx:id="contentContainer"
                    alignment="TOP_LEFT"
                    styleClass="workspace-content">

                    <padding>
                        <Insets top="24" right="24" bottom="24" left="24"/>
                    </padding>

                </StackPane>
            </center>

        </BorderPane>
    </center>

</BorderPane>
