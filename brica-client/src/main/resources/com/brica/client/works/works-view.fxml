<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.brica.client.works.presentation.WorksController" spacing="16" styleClass="clients-root">
    <Label text="Obras" styleClass="content-title"/>
    <Label text="Consulta cada expediente de obra, sus datos generales y su configuración documental." styleClass="content-description"/>
    <FlowPane hgap="8" vgap="8" styleClass="section-actions">
        <Button fx:id="newWorkButton" text="Registrar obra" onAction="#onNewWork" styleClass="primary-button"/>
        <Button fx:id="refreshButton" text="Actualizar" onAction="#onRefresh" styleClass="secondary-button"/>
        <Button fx:id="deleteWorkButton" text="Eliminar" onAction="#onDeleteWork" styleClass="danger-button"/>
        <Button text="Generar documentos" disable="true" styleClass="secondary-button"><tooltip><Tooltip text="Disponible en una próxima iteración."/></tooltip></Button>
    </FlowPane>
    <TableView fx:id="worksTable" VBox.vgrow="ALWAYS" minHeight="240" styleClass="data-table">
        <columns>
            <TableColumn fx:id="clientColumn" text="Cliente" prefWidth="190"/>
            <TableColumn fx:id="nameColumn" text="Nombre" prefWidth="200"/>
            <TableColumn fx:id="descriptionColumn" text="Descripción" prefWidth="240"/>
            <TableColumn fx:id="actionsColumn" text="Acciones" prefWidth="285" minWidth="265" maxWidth="310" sortable="false"/>
        </columns>
        <placeholder><Label text="No hay obras. Crea una con cliente, nombre y descripción."/></placeholder>
    </TableView>
    <Label fx:id="statusLabel" wrapText="true" styleClass="content-note"/>
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="previousPageButton" text="Anterior" onAction="#onPreviousPage" visible="false" managed="false"/>
        <Label fx:id="pageLabel"/>
        <Button fx:id="nextPageButton" text="Siguiente" onAction="#onNextPage" visible="false" managed="false"/>
    </HBox>
</VBox>
